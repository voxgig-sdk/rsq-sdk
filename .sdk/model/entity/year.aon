# Entity: year

main: kit: entity: year: {

  alias: field: {}

  name: "year"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/years"
          segments: [
            {
              lit: "years"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/years/demographics"
          segments: [
            {
              lit: "years"
            }
            {
              lit: "demographics"
            }
          ]
          select: {
            "$action": "demographic"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
