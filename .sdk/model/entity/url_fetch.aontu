# Entity: url_fetch

main: kit: entity: url_fetch: {

  alias: field: {}

  fields: [
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "url_fetch"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "en"
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "url_hash"
                orig: "url_hash"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/fetchUrl"
          parts: [
            "fetchUrl"
          ]
          select: {
            exist: [
              "language"
              "url_hash"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
