  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "LPN"
          },
          "name": {
            "type": "string",
            "example": "Legal and/or Physical Protection Needs"
          }
        }
      },
      "Region": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Middle East and North Africa"
          }
        }
      },
      "CountryOfAsylum": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "HRV"
          },
          "name": {
            "type": "string",
            "example": "Croatia"
          },
          "region": {
            "type": "string",
            "example": "Europe"
          }
        }
      },
      "CountryOfOrigin": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "HRV"
          },
          "name": {
            "type": "string",
            "example": "Croatia"
          },
          "region": {
            "type": "string",
            "example": "Europe"
          }
        }
      },
      "CountryOfResettlement": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "HRV"
          },
          "name": {
            "type": "string",
            "example": "Croatia"
          },
          "region": {
            "type": "string",
            "example": "Europe"
          }
        }
      },
      "UrlFetch": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "invalid"
            ],
            "example": "success"
          },
