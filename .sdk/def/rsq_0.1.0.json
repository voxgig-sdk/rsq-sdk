            "description": "Unexpected error occurred"
          }
        }
      }
    },
    "/submissions": {
      "get": {
        "summary": "Get submissions data",
        "description": "Returns paginated resettlement submissions data for specific parameters. Returns 20 results per page.",
        "operationId": "getSubmissions",
        "tags": [
          "Query"
        ],
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "description": "Return results will be translated in requested language. Defaults to english",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "fr"
              ],
              "default": "en"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Current page of results",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year",
            "in": "query",
            "description": "One or more available years",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "origin",
            "in": "query",
            "description": "One or more country of origin codes",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "originCompare",
            "in": "query",
            "description": "Used in combination with atleast one origin. Groups all other origins as 'All others' entry in results",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "asylum",
            "in": "query",
            "description": "One or more country of asylum codes",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "asylumCompare",
            "in": "query",
            "description": "Used in combination with atleast one asylum. Groups all other asylums as 'All others' entry in results",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "resettlement",
            "in": "query",
            "description": "One or more country of resettlement codes",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "yearSort",
            "in": "query",
            "description": "Sort results by year ascending or descending",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "originSort",
            "in": "query",
            "description": "Sort results by country of origin ascending or descending",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "asylumSort",
            "in": "query",
            "description": "Sort results by country of asylum ascending or descending",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "resettlementSort",
            "in": "query",
            "description": "Sort results by country of resettlement ascending or descending",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "personsSort",
            "in": "query",
            "description": "Sort results by number of persons ascending or descending",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Valid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error occurred"
          }
        }
      }
    },
