    "/fetchUrl": {
      "get": {
        "summary": "Fetch URL from hash",
        "description": "Returns a full URL for existing URL hash. Hash sign has to be converted to HTML entity.",
        "operationId": "fetchUrl",
        "tags": [
          "Helper"
        ],
        "parameters": [
          {
            "name": "urlHash",
            "in": "query",
            "description": "# followed by a combination of 4 letters and/or numbers designating a unique query string",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "description": "Return results will be translated in requested language. Defaults to english",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "fr"
              ],
              "default": "en"
            }
          }
        ],
        "responses": {
