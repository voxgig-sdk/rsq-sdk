            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UrlFetch"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error occurred"
          }
        }
      }
    },
    "/export/csv": {
      "get": {
        "summary": "Export to CSV",
        "description": "Returns queried data in CSV format",
        "operationId": "exportCsv",
        "tags": [
