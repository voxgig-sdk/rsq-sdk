        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Type of data to export",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "description": "One or more available years",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "origin",
            "in": "query",
            "description": "One or more country of origin codes",
            "required": false,
            "schema": {
